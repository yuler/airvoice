---
import '../styles/global.css';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/react/Header';
import DocsSidebar from '../components/react/DocsSidebar';
import TableOfContents from '../components/react/TableOfContents';
import DocsPagination from '../components/react/DocsPagination';
import Footer from '../components/react/Footer';
import { useTranslations, useTranslatedPath, getLangTogglePath } from '../i18n/utils';
import { headerMessages, footerMessages, docsMessages } from '../i18n/messages';
import type { Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  headings: { depth: number; slug: string; text: string }[];
  currentSlug: string;
}

const { title, description, lang, headings, currentSlug } = Astro.props;
const t = useTranslations(lang);
const path = useTranslatedPath(lang);
const docs = docsMessages(t);
const currentPath = Astro.url.pathname;
const langToggle = getLangTogglePath(currentPath, lang);

const docSlugs = ['background', 'quick-start', 'development', 'architecture', 'platform-deps'] as const;
const docLabels: Record<typeof docSlugs[number], string> = {
  background: docs.background,
  'quick-start': docs.quickStart,
  development: docs.development,
  architecture: docs.architecture,
  'platform-deps': docs.platformDeps,
};
const docPages = docSlugs.map((slug) => ({
  slug,
  label: docLabels[slug],
  href: path(`/docs/${slug}/`),
}));

const docPaths = {
  background: path('/docs/background/'),
  quickStart: path('/docs/quick-start/'),
  development: path('/docs/development/'),
  architecture: path('/docs/architecture/'),
  platformDeps: path('/docs/platform-deps/'),
};

const footerPaths = {
  docs: docPaths.background,
  quickStart: docPaths.quickStart,
  architecture: docPaths.architecture,
};
---

<BaseLayout title={title} description={description} lang={lang}>
  <DocsSidebar m={docs} currentPath={currentPath} paths={docPaths} client:load />
  <Header
    m={headerMessages(t, lang)}
    lang={lang}
    active="docs"
    homeUrl={path('/')}
    docsUrl={docPaths.background}
    langTogglePath={langToggle}
    client:load
  />

  <div class="main-content flex flex-col min-h-screen md:ml-64">
    <div class="flex-1">
      <div class="flex">
        <main class="flex-1 overflow-auto px-6 py-10 md:px-12 lg:pr-0">
          <article class="mx-auto max-w-3xl">
            <h1 class="mb-8 text-3xl font-bold tracking-tight text-kumo-default">{title}</h1>
            <div class="prose prose-sm prose-kumo max-w-none">
              <slot />
            </div>
            <DocsPagination m={docs} currentSlug={currentSlug} pages={docPages} client:load />
          </article>
        </main>

        {headings.length > 0 && (
          <aside class="hidden w-80 shrink-0 lg:block">
            <div class="sticky top-24 overflow-auto px-4 py-10">
              <TableOfContents headings={headings} m={docs} client:load />
            </div>
          </aside>
        )}
      </div>
    </div>

    <Footer m={footerMessages(t)} paths={footerPaths} />
  </div>
</BaseLayout>
